auto-install-peers=false
strict-peer-dependencies=false
# Local dev (Windows): don't auto-run `install` before every `pnpm run` script.
# The root preinstall uses `sh`, which isn't on PATH in cmd/PowerShell; this
# avoids that failure and lets scripts launch from any shell. Manage installs
# manually with `pnpm install`.
verify-deps-before-run=false
